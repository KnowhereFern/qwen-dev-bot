{
  "name": "qwen-dev-bot",
  "version": "1.0.0-rc.23",
  "description": "Fern-designed autonomous software delivery harness powered by Qwen3.8-Max, with durable orchestration, runtime rewards, GitHub delivery, and guided setup.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Fern",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KnowhereFern/qwen-dev-bot.git"
  },
  "bugs": {
    "url": "https://github.com/KnowhereFern/qwen-dev-bot/issues"
  },
  "homepage": "https://github.com/KnowhereFern/qwen-dev-bot#readme",
  "engines": {
    "node": ">=22.5"
  },
  "packageManager": "npm@11.12.0",
  "bin": {
    "qwen-harness": "bin/qwen-harness.mjs"
  },
  "files": [
    "agents/",
    "bin/",
    "commands/",
    "docs/",
    "scripts/",
    "skills/",
    "src/",
    "starter-template/",
    "template/",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "LICENSE",
    "DELIVERY-HARNESS.md",
    "README.md",
    "SECURITY.md",
    "qwen-extension.json",
    "tsconfig.json"
  ],
  "scripts": {
    "bootstrap": "node scripts/bootstrap.mjs",
    "preflight": "node scripts/preflight.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck",
    "release:check": "node scripts/release-check.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "starter:create": "node scripts/create-starter.mjs",
    "harness": "node bin/qwen-harness.mjs",
    "setup": "node bin/qwen-harness.mjs init",
    "doctor": "node bin/qwen-harness.mjs doctor"
  },
  "dependencies": {
    "octokit": "^5.0.5",
    "tsx": "^4.23.12"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "typescript": "5.9.2",
    "vitest": "^4.1.11"
  },
  "keywords": [
    "qwen",
    "agentic-coding",
    "autonomous-agents",
    "github-automation",
    "self-repair"
  ]
}
